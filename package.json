{
  "name": "zima-linux-client",
  "version": "2.0.0-alpha.4",
  "description": "Desktop client for ZimaOS on Linux — files, photos, apps and device management",
  "main": "out/main/index.js",
  "author": {
    "name": "Holger Kühn",
    "email": "zima-client@virtual-services.info"
  },
  "desktopName": "zima-linux-client.desktop",
  "homepage": "https://github.com/chicohaager/zima-linux-client",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:x11": "electron-vite dev -- --ozone-platform=x11",
    "build": "npm run type-check && electron-vite build",
    "start": "electron-vite preview",
    "type-check": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "package:linux": "npm run build && electron-builder --linux",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "package:deb": "npm run build && electron-builder --linux deb",
    "package:tar": "npm run build && electron-builder --linux tar.gz",
    "package:rpm": "npm run build && electron-builder --linux rpm",
    "package:pacman": "npm run build && electron-builder --linux pacman",
    "package:flatpak": "npm run build && electron-builder --linux flatpak",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run type-check && npm run lint && npm test && npm run build && npm run verify:build && npm run verify:i18n && npm run verify:privacy",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/screenshots.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:release:self-test": "node scripts/verify-release.mjs --self-test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "i18next": "^25.6.3",
    "react-i18next": "^16.3.5",
    "zod": "^4.1.13",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.18.11",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "productName": "ZimaOS Client",
    "appId": "com.zimaos.client",
    "publish": [
      {
        "provider": "github",
        "owner": "chicohaager",
        "repo": "zima-linux-client",
        "releaseType": "release"
      }
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      "icon.png",
      {
        "from": "bin/zerotier/${arch}",
        "to": "zerotier/${arch}"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "category": "Network",
      "icon": "icon.png",
      "syncDesktopName": true,
      "synopsis": "Desktop client for ZimaOS",
      "description": "Files, photos, apps and device management for ZimaOS devices — over LAN, direct IP or Remote ID."
    },
    "deb": {
      "maintainer": "Holger Kühn <zima-client@virtual-services.info>",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2",
        "libgbm1",
        "libcap2-bin"
      ],
      "afterInstall": "build/linux-after-install.sh"
    },
    "rpm": {
      "fpm": [
        "--license=MIT"
      ],
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "libasound.so.2()(64bit)",
        "libgbm.so.1()(64bit)",
        "/usr/sbin/setcap"
      ],
      "afterInstall": "build/linux-after-install.sh"
    },
    "pacman": {
      "depends": [
        "c-ares",
        "ffmpeg",
        "gtk3",
        "libevent",
        "libvpx",
        "libxslt",
        "libxss",
        "minizip",
        "nss",
        "re2",
        "snappy",
        "libnotify",
        "libappindicator-gtk3",
        "libcap"
      ],
      "afterInstall": "build/linux-after-install.sh"
    }
  }
}
